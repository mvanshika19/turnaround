# Copy to .env.local to override. Every variable is optional.

# Base URL of the Turnaround API. Defaults to /api, which the Vite dev server proxies to the
# backend at http://127.0.0.1:8000. Set it only when the API is served from another origin,
# for example https://api.example.com/api (that origin must allow this site in its CORS settings).
VITE_API_BASE_URL=/api
