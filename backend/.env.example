# Copy to .env to override defaults. Every value shown is the default.

# "development" or "production".
TURNAROUND_ENVIRONMENT=development

# Python logging level: DEBUG, INFO, WARNING, ERROR.
TURNAROUND_LOG_LEVEL=INFO

# Origins allowed by CORS, as a JSON list.
TURNAROUND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Which planner answers requests: "mock" (placeholder) or "model" (not implemented yet).
TURNAROUND_PLANNER=mock

# IANA time zone for all trail times.
TURNAROUND_TIMEZONE=America/Vancouver

# Directory holding trails/, cache/ and gpx/. Leave unset to use backend/data.
# TURNAROUND_DATA_DIR=

# API key for the AI co-pilot (a later phase). Leave empty until then.
TURNAROUND_OPENAI_API_KEY=

# OpenAI model the co-pilot uses.
TURNAROUND_OPENAI_MODEL=gpt-6.2-sol

# Most tool-calling rounds the co-pilot may use per question.
TURNAROUND_COPILOT_MAX_TOOL_ROUNDS=5
